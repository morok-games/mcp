@{
    ViewData["Title"] = "Chat";
}

<style>
    /* The chat fills the viewport below the navbar; only the message list scrolls */
    #chat { height: calc(100vh - 150px); min-height: 420px; }
    #history { overflow-y: auto; }
    .msg { max-width: 80%; white-space: pre-wrap; word-wrap: break-word; }
    /* Markdown replies: HTML provides the structure, so no pre-wrap */
    .msg.md { white-space: normal; }
    .msg.md > :last-child { margin-bottom: 0; }
    .msg.md ul { padding-left: 1.25rem; margin-bottom: .5rem; }
    .msg.md p { margin-bottom: .5rem; }
</style>

<div id="chat" class="d-flex flex-column bg-body rounded shadow-sm">
    <div class="d-flex justify-content-between align-items-center border-bottom px-3 py-2">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="fw-semibold">Assistant playground</span>
            <span class="badge text-bg-warning fw-normal" title="The free tier is often overloaded; the server falls back to other models, which takes extra time">
                <i class="bi bi-exclamation-triangle-fill"></i>
                Answers use a free Gemini API key, so replies may take a while
            </span>
        </div>
        <button id="clearBtn" type="button" class="btn btn-sm btn-outline-secondary">New chat</button>
    </div>

    <div id="history" class="flex-grow-1 p-3">
        <div id="messages" class="d-flex flex-column gap-2"></div>
    </div>

    <form id="chatForm" class="d-flex gap-2 border-top p-3">
        <textarea id="input" class="form-control" rows="1" placeholder="Ask something..." autofocus></textarea>
        <button id="sendBtn" type="submit" class="btn btn-primary px-4">Send</button>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>
    <script>
        const messages = [];          // full chat history; sent to the server on every request
        const list = document.getElementById('messages');
        const history = document.getElementById('history');
        const form = document.getElementById('chatForm');
        const input = document.getElementById('input');
        const sendBtn = document.getElementById('sendBtn');

        function render(role, text, extraClass = '') {
            const div = document.createElement('div');
            div.className = role === 'user'
                ? 'msg align-self-end bg-primary text-white rounded-3 px-3 py-2'
                : `msg align-self-start bg-body-tertiary border rounded-3 px-3 py-2 ${extraClass}`;
            div.textContent = text;
            list.appendChild(div);
            history.scrollTop = history.scrollHeight;
            return div;
        }

        let failed = null; // { userBubble, errorBubble } of the last unanswered message

        function send(text) {
            // A new message replaces a failed one instead of leaving it unanswered in history
            if (failed) {
                messages.pop();
                failed.userBubble.remove();
                failed.errorBubble.remove();
                failed = null;
            }

            messages.push({ role: 'user', text });
            const userBubble = render('user', text);
            requestReply(userBubble);
        }

        async function requestReply(userBubble) {
            const pending = render('assistant', 'Thinking…', 'text-secondary');
            sendBtn.disabled = true;

            try {
                const res = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ messages })
                });
                if (res.status === 401) {
                    window.location.reload(); // session expired: the page redirects to the login form
                    return;
                }
                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    throw new Error(err.detail || err.title || `HTTP ${res.status}`);
                }
                const data = await res.json();
                messages.push({ role: 'assistant', text: data.reply });
                pending.classList.remove('text-secondary');
                pending.classList.add('md');
                // LLM output is untrusted: sanitize the rendered Markdown before inserting it
                pending.innerHTML = DOMPurify.sanitize(marked.parse(data.reply));
                pending.querySelectorAll('a').forEach(a => { a.target = '_blank'; a.rel = 'noopener'; });
                renderActions(pending, data.actions || []);
            } catch (e) {
                showError(pending, e.message, userBubble);
            } finally {
                sendBtn.disabled = false;
                input.focus();
            }
        }

        // Buttons built by the server from catalog data: checkout links and quick replies
        function renderActions(bubble, actions) {
            if (actions.length === 0) return;

            const bar = document.createElement('div');
            bar.className = 'd-flex flex-wrap gap-2 mt-2';

            for (const action of actions) {
                if (action.type === 'Checkout') {
                    const link = document.createElement('a');
                    link.className = 'btn btn-success btn-sm';
                    link.href = action.url;
                    link.target = '_blank';
                    link.rel = 'noopener';
                    link.textContent = action.label;
                    bar.appendChild(link);
                } else if (action.type === 'Reply') {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'btn btn-outline-primary btn-sm';
                    button.textContent = action.label;
                    button.addEventListener('click', () => {
                        if (sendBtn.disabled) return;
                        bar.remove();
                        send(action.text);
                    });
                    bar.appendChild(button);
                }
            }

            bubble.appendChild(bar);
            history.scrollTop = history.scrollHeight;
        }

        function showError(bubble, message, userBubble) {
            bubble.className = 'msg align-self-start border border-danger-subtle bg-danger-subtle rounded-3 px-3 py-2';
            bubble.textContent = '';

            const text = document.createElement('div');
            text.className = 'text-danger-emphasis mb-2';
            text.textContent = 'Error: ' + message;

            const retry = document.createElement('button');
            retry.type = 'button';
            retry.className = 'btn btn-sm btn-outline-danger';
            retry.textContent = 'Retry';
            retry.addEventListener('click', () => {
                if (sendBtn.disabled) return;
                failed = null;
                bubble.remove();
                requestReply(userBubble); // the user message is still the last one in history
            });

            bubble.append(text, retry);
            failed = { userBubble, errorBubble: bubble };
        }

        form.addEventListener('submit', e => {
            e.preventDefault();
            const text = input.value.trim();
            if (!text || sendBtn.disabled) return;
            input.value = '';
            send(text);
        });

        // Enter sends, Shift+Enter inserts a new line
        input.addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                form.requestSubmit();
            }
        });

        document.getElementById('clearBtn').addEventListener('click', () => {
            messages.length = 0;
            failed = null;
            list.innerHTML = '';
            input.focus();
        });
    </script>
}
