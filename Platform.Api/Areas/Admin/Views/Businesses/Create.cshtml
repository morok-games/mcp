@model BusinessCreateModel
@{
    ViewData["Title"] = "Add business";
}

<h1 class="h3 mb-3">Add business</h1>

<form asp-action="Create" method="post" class="bg-body rounded shadow-sm p-4" style="max-width: 36rem">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="Victory Skating" autofocus />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SourceUrl" class="form-label"></label>
        <input asp-for="SourceUrl" class="form-control" placeholder="https://victoryskating.com/doubleaxel" />
        <span asp-validation-for="SourceUrl" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="SourcePlatform" class="form-label"></label>
        <select asp-for="SourcePlatform" asp-items="ViewBag.Platforms" class="form-select"></select>
        <span asp-validation-for="SourcePlatform" class="text-danger small"></span>
        <div class="mt-2">
            <span class="badge text-bg-warning fw-normal text-wrap text-start" title="The free tier is often overloaded; the server falls back to other models, which takes extra time">
                <i class="bi bi-exclamation-triangle-fill"></i>
                Import uses a free Gemini API key, so it may take a while
            </span>
        </div>
    </div>

    <div class="mb-4">
        <label asp-for="ExtractionInstructions" class="form-label"></label>
        <textarea asp-for="ExtractionInstructions" class="form-control" rows="5"
                  placeholder="'$6/class' is a derived per-class price, not a separate pricing option."></textarea>
        <span asp-validation-for="ExtractionInstructions" class="text-danger small"></span>
        <div class="form-text">Hints for the AI that parses this site, e.g. how to read its prices or dates. Can be changed later.</div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
