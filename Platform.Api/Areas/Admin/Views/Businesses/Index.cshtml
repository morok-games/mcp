@model IReadOnlyList<BusinessRow>
@{
    ViewData["Title"] = "Businesses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Businesses</h1>
    <a asp-action="Create" class="btn btn-primary">Add business</a>
</div>

@if (Model.Count == 0)
{
    <div class="text-secondary">No businesses yet.</div>
}
else
{
    <div class="table-responsive bg-body rounded shadow-sm">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Business</th>
                    <th>Import source</th>
                    <th>Last import</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="fw-semibold">@b.Name</td>
                        <td class="small">
                            @if (b.Source is not null)
                            {
                                <div><span class="text-secondary">Adapter:</span> @b.Source.Platform</div>
                                <a href="@b.Source.Url" target="_blank" rel="noopener" class="text-break">@b.Source.Url</a>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </td>
                        <td class="small">
                            @if (b.Source?.LastImportedAt is { } at)
                            {
                                <span class="text-secondary">@at.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                @if (b.Source.LastImportSucceeded != true)
                                {
                                    <span class="badge text-bg-danger">Failed</span>
                                }
                                else if (b.Source.HasWarnings)
                                {
                                    <i class="bi bi-exclamation-triangle-fill text-warning" title="Imported with warnings"></i>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">OK</span>
                                }

                                @* Details only when there is something to read: warnings or the error message *@
                                @if (!string.IsNullOrWhiteSpace(b.Source.LastImportSummary))
                                {
                                    <details>
                                        <summary class="text-secondary">Details</summary>
                                        <ul class="mb-0 ps-3" style="max-width: 28rem">
                                            @foreach (var line in b.Source.LastImportSummary.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <li>@line</li>
                                            }
                                        </ul>
                                    </details>
                                }
                            }
                            else
                            {
                                <span class="text-secondary">Never</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            <form asp-action="Import" asp-route-id="@b.Id" method="post" class="d-inline import-form">
                                <button type="submit" class="btn btn-sm btn-outline-primary" @(b.Source is null ? "disabled" : "")>
                                    <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                                    <span class="label">Import</span>
                                </button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@b.Id" method="post" class="d-inline delete-form"
                                  data-name="@b.Name">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        // Import calls the LLM and can take up to a minute: show progress and block double submits
        document.querySelectorAll('.import-form').forEach(form => form.addEventListener('submit', () => {
            document.querySelectorAll('.import-form button, .delete-form button').forEach(b => b.disabled = true);
            form.querySelector('.spinner-border').classList.remove('d-none');
            form.querySelector('.label').textContent = 'Importing…';
        }));

        document.querySelectorAll('.delete-form').forEach(form => form.addEventListener('submit', e => {
            if (!confirm(`Delete "${form.dataset.name}" with all its offerings? This cannot be undone.`))
                e.preventDefault();
        }));
    </script>
}
